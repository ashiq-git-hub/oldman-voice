# Supabase Public API URL & Anon Key (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Backend server-only, NEVER exposed to client)
# Used for administrative maintenance and verification if needed
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Next.js public site URL for production metadata
NEXT_PUBLIC_SITE_URL=https://oldman-voice.vercel.app
